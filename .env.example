# ============================================================
#  VSLA Connect — Environment Variable Template
#  Copy this file to .env.local and fill in real values.
#  NEVER commit .env.local to the repository.
#
#  Live URL: https://vlsa-connect.vercel.app
# ============================================================

# ------------------------------------------------------------
# DATABASE — Neon (Serverless PostgreSQL via Prisma)
# ------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Neon also exposes a pooled URL for serverless edge functions:
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ------------------------------------------------------------
# NEXTAUTH / SESSION
# ------------------------------------------------------------
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="https://vlsa-connect.vercel.app"

# ------------------------------------------------------------
# AFRICA'S TALKING — USSD & SMS
# Docs: https://developers.africastalking.com
#
# USSD Callback URL  → paste into Africa's Talking USSD dashboard:
#   https://vlsa-connect.vercel.app/api/ussd
#
# SMS Delivery Report URL → paste into Africa's Talking SMS dashboard:
#   https://vlsa-connect.vercel.app/api/sms/delivery
# ------------------------------------------------------------
AT_API_KEY="your-africastalking-api-key"
AT_USERNAME="your-africastalking-username"
# Sandbox username is always "sandbox"
AT_SHORTCODE="*384*your-shortcode#"
AT_SENDER_ID="VSLA"

# ------------------------------------------------------------
# PAYCHANGU — Mobile Money & Card Payments
# Docs: https://paychangu.com/developers
#
# Webhook/Callback URL → paste into PayChangu dashboard:
#   https://vlsa-connect.vercel.app/api/payments/callback
#
# Return URL (redirect after hosted payment page):
#   https://vlsa-connect.vercel.app/api/payments/verify
# ------------------------------------------------------------
PAYCHANGU_SECRET_KEY="your-paychangu-secret-key"
PAYCHANGU_PUBLIC_KEY="your-paychangu-public-key"
PAYCHANGU_BASE_URL="https://api.paychangu.com"
PAYCHANGU_CALLBACK_URL="https://vlsa-connect.vercel.app/api/payments/callback"
PAYCHANGU_RETURN_URL="https://vlsa-connect.vercel.app/api/payments/verify"

# ------------------------------------------------------------
# AI / LLM — Groq API
# Docs: https://console.groq.com/docs
# ------------------------------------------------------------
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="llama3-8b-8192"

# ------------------------------------------------------------
# CLOUDINARY — Media & File Storage (profile photos, exports)
# Docs: https://cloudinary.com/documentation
#
# Notification URL (upload webhooks) → paste into Cloudinary dashboard:
#   https://vlsa-connect.vercel.app/api/media/notify
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# ------------------------------------------------------------
# EMAIL — SMTP (transactional email, e.g. password reset)
# Works with any SMTP provider: Resend, SendGrid, Mailgun, etc.
# ------------------------------------------------------------
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="resend"
SMTP_PASSWORD="your-smtp-password-or-api-key"
SMTP_FROM="noreply@vslaconnect.mw"

# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://vlsa-connect.vercel.app"
NODE_ENV="production"

